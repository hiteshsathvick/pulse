# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
build/
dist/

# Node
node_modules/
.next/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo
frontend/playwright-report/
frontend/test-results/

# Env
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db

# Local tooling (dev-server launch config for the built-in browser preview
# tool) -- machine-specific convenience, not project source; matches this
# author's other repos, none of which track .claude/.
.claude/

# Phase 17 load tests: .bench.json holds API keys, the CSVs are raw locust output
backend/loadtests/.bench.json
backend/loadtests/results/*.csv

# Terraform: provider plugins and, critically, STATE -- state files contain the
# generated database/ClickHouse/IAM secrets in plain text and must never be
# committed. (The lock file .terraform.lock.hcl IS committed, on purpose.)
infra/terraform/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.secret.tfvars
*.auto.tfvars
crash.log

# Opt-in remote-state config: copied from backend_override.tf.example per machine.
infra/terraform/backend_override.tf
