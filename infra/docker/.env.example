# Copy to .env in this directory before running `docker compose up`.
# Never commit the real .env.

POSTGRES_USER=pulse
POSTGRES_PASSWORD=pulse
POSTGRES_DB=pulse

# A separate, non-superuser role that the app/migrations actually connect as
# (Row-Level Security is unconditionally bypassed for superusers, even with
# FORCE ROW LEVEL SECURITY -- see backend/alembic/env.py). Created
# idempotently by alembic/env.py using POSTGRES_USER above; you don't need to
# create it yourself.
POSTGRES_APP_USER=pulse_app
POSTGRES_APP_PASSWORD=pulse_app

CLICKHOUSE_USER=pulse
CLICKHOUSE_PASSWORD=pulse
CLICKHOUSE_DB=pulse

MINIO_ROOT_USER=pulse
MINIO_ROOT_PASSWORD=pulse12345
